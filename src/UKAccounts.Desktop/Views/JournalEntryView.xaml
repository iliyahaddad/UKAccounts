<Window x:Class="UKAccounts.Desktop.Views.JournalEntryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Journal Entry" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Journal Entry" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="DatePicker" Width="150" Margin="0,0,20,0"/>
            <TextBlock Text="Reference:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="ReferenceTextBox" Width="150" Margin="0,0,20,0"/>
        </StackPanel>

        <TextBlock Text="Description:" Grid.Row="2" Margin="0,0,0,5"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="2" Height="30" Margin="0,0,0,10"/>

        <DataGrid x:Name="LinesDataGrid" Grid.Row="3" Margin="0,0,0,10" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="200"/>
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit}" Width="100"/>
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add Line" Width="80" Margin="0,0,10,0" Click="AddLine_Click"/>
            <Button Content="Post" Width="80" Margin="0,0,10,0" Click="Post_Click"/>
            <Button Content="Close" Width="80" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
