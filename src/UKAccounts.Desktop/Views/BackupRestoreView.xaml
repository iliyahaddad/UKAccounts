<Window x:Class="UKAccounts.Desktop.Views.BackupRestoreView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup &amp; Restore" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Backup &amp; Restore" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Create Backup" Width="120" Margin="0,0,10,0" Click="CreateBackup_Click"/>
            <Button Content="Restore Backup" Width="120" Click="RestoreBackup_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Margin="0,0,0,10" Foreground="Gray"/>

        <DataGrid x:Name="BackupsDataGrid" Grid.Row="3" Margin="0,0,0,10" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Backup File" Binding="{Binding}" Width="400"/>
                <DataGridTextColumn Header="Date" Binding="{Binding}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="80" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
